<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="16dp" android:background="@drawable/call_notification_bg">
    <ImageView android:id="@+id/call_photo" android:layout_width="72dp" android:layout_height="72dp"
        android:scaleType="centerCrop" android:src="@android:drawable/sym_def_app_icon" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/call_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Caller" android:textSize="22sp" android:textColor="#FFF5F5F5" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Incoming call" android:textSize="16sp" android:textColor="#FFBDBDBD" android:layout_marginTop="4dp" />
    </LinearLayout>
    <ImageButton android:id="@+id/call_decline" android:layout_width="56dp" android:layout_height="56dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel" android:contentDescription="Decline call"
        android:background="@drawable/call_decline_bg" android:tint="#FFFFFFFF" android:padding="15dp" />
    <ImageButton android:id="@+id/call_answer" android:layout_width="56dp" android:layout_height="56dp"
        android:src="@android:drawable/sym_action_call" android:contentDescription="Answer call"
        android:background="@drawable/call_answer_bg" android:tint="#FFFFFFFF" android:padding="15dp"
        android:layout_marginStart="10dp" />
</LinearLayout>